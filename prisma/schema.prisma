generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum JobState {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}
enum SourceRunState {
  QUEUED
  FETCHING
  VALIDATING
  RETRY_SCHEDULED
  AGENT_ESCALATED
  REPLAYING
  VERIFIED
  FAILED
  BLOCKED
}
enum CoverageOutcome {
  NOT_SEARCHED
  SEARCHED_UNRESOLVED
  VERIFIED
  FAILED
  CONFLICTING
  NOT_APPLICABLE
}
enum ClaimStatus {
  CANDIDATE
  ACCEPTED
  REJECTED
  CONFLICTING
}
enum InvestorRole {
  LEAD
  CO_LEAD
  PARTICIPANT
  UNSPECIFIED
}
model Investor {
  id String @id @default(cuid())
  name String @unique
  canonicalDomain String? @unique
  rationale String?
  sources Source[]
  portfolioRelationships PortfolioRelationship[]
  roundInvestors RoundInvestor[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Company {
  id String @id @default(cuid())
  name String @unique
  canonicalDomain String? @unique
  description String?
  aliases EntityAlias[]
  sources Source[]
  portfolioRelationships PortfolioRelationship[]
  fundingRounds FundingRound[]
  coverageChecks CoverageCheck[]
  claims Claim[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model EntityAlias {
  id String @id @default(cuid())
  companyId String
  alias String
  evidenceUrl String?
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  @@unique([companyId,alias])
}
model PortfolioRelationship {
  id String @id @default(cuid())
  investorId String
  companyId String
  sourceId String
  observedAt DateTime?
  investor Investor @relation(fields:[investorId],references:[id],onDelete:Cascade)
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  source Source @relation(fields:[sourceId],references:[id])
  @@unique([investorId,companyId,sourceId])
}
model FundingRound {
  id String @id @default(cuid())
  companyId String
  stage String
  announcedAt DateTime?
  closedAt DateTime?
  amount Decimal?
  currency String?
  status ClaimStatus @default(CANDIDATE)
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  investors RoundInvestor[]
  claims Claim[]
  @@index([companyId,announcedAt])
}
model RoundInvestor {
  id String @id @default(cuid())
  fundingRoundId String
  investorId String
  role InvestorRole @default(UNSPECIFIED)
  sourceId String?
  fundingRound FundingRound @relation(fields:[fundingRoundId],references:[id],onDelete:Cascade)
  investor Investor @relation(fields:[investorId],references:[id])
  @@unique([fundingRoundId,investorId])
}
model Source {
  id String @id @default(cuid())
  url String @unique
  type String
  capabilities String[]
  rationale String?
  adapter String?
  refreshPolicy String?
  knownLimitations String?
  allowedDomains String[] @default([])
  lastSuccessAt DateTime?
  investorId String?
  companyId String?
  investor Investor? @relation(fields:[investorId],references:[id])
  company Company? @relation(fields:[companyId],references:[id])
  documents Document[]
  portfolioRelationships PortfolioRelationship[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Document {
  id String @id @default(cuid())
  sourceId String
  canonicalUrl String @unique
  title String?
  publishedAt DateTime?
  fetchedAt DateTime @default(now())
  statusCode Int?
  responseContentType String?
  contentHash String
  snapshotKey String?
  source Source @relation(fields:[sourceId],references:[id])
  versions DocumentVersion[]
  assessments DocumentAssessment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model DocumentAssessment {
  id String @id @default(cuid())
  documentId String
  model String
  adapterVerdict String
  renderingVerdict String
  completenessVerdict String
  confidence Decimal?
  inputHash String
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
  @@index([documentId,createdAt])
}
model DocumentVersion {
  id String @id @default(cuid())
  documentId String
  body String
  parserVersion String
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
  chunks DocumentChunk[]
  evidence ClaimEvidence[]
}
model DocumentChunk {
  id String @id @default(cuid())
  documentVersionId String
  ordinal Int
  startOffset Int?
  endOffset Int?
  text String
  embeddingModel String
  embeddingVersion String
  documentVersion DocumentVersion @relation(fields:[documentVersionId],references:[id],onDelete:Cascade)
  @@unique([documentVersionId,ordinal])
}
model Claim {
  id String @id @default(cuid())
  companyId String?
  fundingRoundId String?
  predicate String
  value Json
  status ClaimStatus @default(CANDIDATE)
  reviewNote String?
  company Company? @relation(fields:[companyId],references:[id],onDelete:Cascade)
  fundingRound FundingRound? @relation(fields:[fundingRoundId],references:[id],onDelete:Cascade)
  evidence ClaimEvidence[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ClaimEvidence {
  id String @id @default(cuid())
  claimId String
  documentVersionId String
  passage String
  startOffset Int?
  endOffset Int?
  claim Claim @relation(fields:[claimId],references:[id],onDelete:Cascade)
  documentVersion DocumentVersion @relation(fields:[documentVersionId],references:[id],onDelete:Cascade)
  @@unique([claimId,documentVersionId,passage])
}
model CoverageCheck {
  id String @id @default(cuid())
  companyId String
  taskType String
  scope Json
  outcome CoverageOutcome @default(NOT_SEARCHED)
  reason String?
  lastVerifiedAt DateTime?
  nextDueAt DateTime?
  attemptId String?
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  @@unique([companyId,taskType])
}
model Job {
  id String @id @default(cuid())
  type String
  entityId String?
  deduplicationKey String @unique
  state JobState @default(PENDING)
  attempts Int @default(0)
  progress String?
  leaseUntil DateTime?
  cost Decimal?
  payload Json?
  rendererCommandHash String?
  rendererCommandExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attemptsLog JobAttempt[]
  outbox Outbox[]
  renderArtifacts RenderArtifact[]
}
model RenderArtifact {
  id String @id @default(cuid())
  jobId String
  artifactPrefix String
  finalUrl String?
  statusCode Int?
  telemetry Json
  createdAt DateTime @default(now())
  job Job @relation(fields:[jobId],references:[id],onDelete:Cascade)
  @@unique([jobId,artifactPrefix])
  @@index([jobId,createdAt])
}
model JobAttempt {
  id String @id @default(cuid())
  jobId String
  state JobState
  error String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  job Job @relation(fields:[jobId],references:[id],onDelete:Cascade)
}
model Outbox {
  id String @id @default(cuid())
  jobId String
  topic String
  payload Json
  deliveredAt DateTime?
  deliveryAttempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  job Job @relation(fields:[jobId],references:[id],onDelete:Cascade)
  @@index([deliveredAt,createdAt])
}
model Conversation {
  id String @id @default(cuid())
  ownerId String
  title String?
  messages Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Message {
  id String @id @default(cuid())
  conversationId String
  role String
  content Json
  citations Json?
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
}
model ResearchRequest {
  id String @id @default(cuid())
  ownerId String?
  scope Json
  jobId String?
  createdAt DateTime @default(now())
}
model ResearchRun {
  id String @id @default(cuid())
  label String?
  state SourceRunState @default(QUEUED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sourceRuns SourceRun[]
}
model SourceRun {
  id String @id @default(cuid())
  researchRunId String
  url String
  sourceKind String
  state SourceRunState @default(QUEUED)
  stage String @default("Queued")
  attempts Int @default(0)
  maxAttempts Int @default(4)
  nextRetryAt DateTime?
  workflowRunId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  researchRun ResearchRun @relation(fields:[researchRunId],references:[id],onDelete:Cascade)
  events SourceRunEvent[]
  @@index([researchRunId,updatedAt])
  @@index([state,nextRetryAt])
}
model SourceRunEvent {
  id String @id @default(cuid())
  sourceRunId String
  state SourceRunState
  stage String
  message String
  metadata Json?
  createdAt DateTime @default(now())
  sourceRun SourceRun @relation(fields:[sourceRunId],references:[id],onDelete:Cascade)
  @@index([sourceRunId,createdAt])
}
