generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum CoverageOutcome { NOT_SEARCHED SEARCHED_UNRESOLVED VERIFIED FAILED CONFLICTING NOT_APPLICABLE }
enum JobState { PENDING QUEUED RUNNING SUCCEEDED FAILED DEAD_LETTER }
model Investor { id String @id @default(cuid()); name String @unique; canonicalDomain String?; createdAt DateTime @default(now()); relationships PortfolioRelationship[]; sources Source[]; roundInvestments RoundInvestor[] }
model Company { id String @id @default(cuid()); name String @unique; canonicalDomain String?; createdAt DateTime @default(now()); relationships PortfolioRelationship[]; rounds FundingRound[]; coverage CoverageCheck[]; sources Source[] }
model PortfolioRelationship { id String @id @default(cuid()); investorId String; companyId String; observedAt DateTime?; evidenceId String; investor Investor @relation(fields:[investorId],references:[id]); company Company @relation(fields:[companyId],references:[id]); @@unique([investorId,companyId,evidenceId]) }
model FundingRound { id String @id @default(cuid()); companyId String; stage String?; announcedAt DateTime?; amount Decimal?; currency String?; company Company @relation(fields:[companyId],references:[id]); investors RoundInvestor[] }
model RoundInvestor { id String @id @default(cuid()); roundId String; investorId String; role String?; round FundingRound @relation(fields:[roundId],references:[id]); investor Investor @relation(fields:[investorId],references:[id]); @@unique([roundId,investorId]) }
model Source { id String @id @default(cuid()); url String @unique; type String; capabilities String[]; rationale String?; lastSuccessAt DateTime?; investorId String?; companyId String?; investor Investor? @relation(fields:[investorId],references:[id]); company Company? @relation(fields:[companyId],references:[id]); documents Document[] }
model Document { id String @id @default(cuid()); sourceId String; canonicalUrl String @unique; title String?; publishedAt DateTime?; fetchedAt DateTime @default(now()); contentHash String; snapshotKey String?; source Source @relation(fields:[sourceId],references:[id]); versions DocumentVersion[] }
model DocumentVersion { id String @id @default(cuid()); documentId String; body String; parserVersion String; createdAt DateTime @default(now()); document Document @relation(fields:[documentId],references:[id]); evidence ClaimEvidence[]; chunks DocumentChunk[] }
model Claim { id String @id @default(cuid()); subjectId String; predicate String; value Json; status String; evidence ClaimEvidence[] }
model ClaimEvidence { id String @id @default(cuid()); claimId String; documentVersionId String; passage String; startOffset Int?; endOffset Int?; claim Claim @relation(fields:[claimId],references:[id]); documentVersion DocumentVersion @relation(fields:[documentVersionId],references:[id]) }
model DocumentChunk { id String @id @default(cuid()); documentVersionId String; ordinal Int; text String; embeddingModel String; embeddingVersion String; documentVersion DocumentVersion @relation(fields:[documentVersionId],references:[id]); @@unique([documentVersionId,ordinal]) }
model CoverageCheck { id String @id @default(cuid()); companyId String; taskType String; scope Json; outcome CoverageOutcome; lastVerifiedAt DateTime?; nextDueAt DateTime?; company Company @relation(fields:[companyId],references:[id]); @@unique([companyId,taskType]) }
model Job { id String @id @default(cuid()); type String; entityId String?; deduplicationKey String @unique; state JobState @default(PENDING); attempts Int @default(0); leaseUntil DateTime?; cost Decimal?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; attemptsLog JobAttempt[]; outbox Outbox[] }
model JobAttempt { id String @id @default(cuid()); jobId String; state JobState; error String?; startedAt DateTime @default(now()); finishedAt DateTime?; job Job @relation(fields:[jobId],references:[id]) }
model Outbox { id String @id @default(cuid()); jobId String; destination String; deliveredAt DateTime?; attempts Int @default(0); job Job @relation(fields:[jobId],references:[id]) }
