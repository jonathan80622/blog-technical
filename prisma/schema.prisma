generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobState {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

model Source {
  id            String     @id @default(cuid())
  url           String     @unique
  type          String
  capabilities  String[]
  rationale     String?
  lastSuccessAt DateTime?
  documents     Document[]
}

model Document {
  id           String            @id @default(cuid())
  sourceId     String
  canonicalUrl String            @unique
  title        String?
  publishedAt  DateTime?
  fetchedAt    DateTime          @default(now())
  contentHash  String
  snapshotKey  String?
  source       Source            @relation(fields: [sourceId], references: [id])
  versions     DocumentVersion[]
}

model DocumentVersion {
  id            String          @id @default(cuid())
  documentId    String
  body          String
  parserVersion String
  createdAt     DateTime        @default(now())
  document      Document        @relation(fields: [documentId], references: [id])
  chunks        DocumentChunk[]
}

model DocumentChunk {
  id                String          @id @default(cuid())
  documentVersionId String
  ordinal           Int
  text              String
  embeddingModel    String
  embeddingVersion  String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])

  @@unique([documentVersionId, ordinal])
}

model Job {
  id               String       @id @default(cuid())
  type             String
  entityId         String?
  deduplicationKey String       @unique
  state            JobState     @default(PENDING)
  attempts         Int          @default(0)
  progress         String?
  leaseUntil       DateTime?
  cost             Decimal?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attemptsLog      JobAttempt[]
}

model JobAttempt {
  id         String   @id @default(cuid())
  jobId      String
  state      JobState
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  job        Job      @relation(fields: [jobId], references: [id])
}
