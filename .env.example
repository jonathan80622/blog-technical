# Runtime: use the Prisma Postgres pooled endpoint (pooled.db.prisma.io).
DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/vc_intelligence"
# CI migrations/admin commands: use the direct endpoint (db.prisma.io), not the pooled URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/vc_intelligence"
# Omit to select 5 for a pooled URL and 1 for a direct/unknown URL. Never set above 5.
VC_DISCOVERY_MAX_ACTIVE=""
OPENAI_API_KEY=""
# Optional model for the isolated company-website search (default: gpt-5.5).
OPENAI_COMPANY_URL_MODEL=""
OPENAI_CHAT_MODEL=""
OPENAI_DECISIONS_MODEL="gpt-6-luna"
EMBEDDING_MODEL=""
EMBEDDING_DIMENSIONS="1536"
SEARCH_API_KEY=""
REDIS_URL=""
AWS_REGION=""
SQS_QUEUE_URL=""
S3_SNAPSHOT_BUCKET=""
